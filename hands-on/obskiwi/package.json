{
  "name": "obskiwi",
  "version": "0.1.0",
  "description": "OBS Studio의 핵심 개념(장면, 소스, 합성, 오디오 믹서, 전환, 녹화)을 따라 만든 교육용 데스크톱 앱",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.main.json",
    "start": "electron .",
    "dev": "npm run build && npm run start"
  },
  "dependencies": {
    "electron": "45.3.1",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
