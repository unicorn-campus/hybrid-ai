# ComfyUI H3가 이미 실행 중인 주소입니다. 모델은 새로 다운로드하지 않습니다.
COMFYUI_URL=http://127.0.0.1:8188
PORT=3010
HOST=127.0.0.1
# 선택: 결과 기록과 업로드를 저장할 폴더입니다. 기본값은 .data입니다.
# VIDEOKIWI_DATA_DIR=/absolute/path/to/data
# 다른 기기에 직접 공개할 때에만 HOST를 바꾸고 16자 이상 비밀번호를 지정합니다.
# VIDEOKIWI_ACCESS_TOKEN=
# 프롬프트 제안은 서버 사용자의 Claude Code 구독 로그인을 사용합니다.
# 별도 ANTHROPIC_API_KEY는 이 기능에서 사용하지 않습니다.
VIDEOKIWI_CLAUDE_MODEL=claude-opus-5-5
# 선택: 별도로 설치한 Claude Code 실행 파일의 절대 경로입니다.
# VIDEOKIWI_CLAUDE_PATH=C:/Users/your-name/.local/bin/claude.exe
