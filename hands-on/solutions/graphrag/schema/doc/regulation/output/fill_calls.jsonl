{"chunk_id": "regulation:제10조", "raw_nodes": ["TermsDocument", "Clause", "Requirement", "Requirement", "Deadline", "Handling", "Requirement", "Handling", "Requirement", "Handling", "Deadline", "Handling", "Deadline", "Handling"], "raw_rels": ["HAS_CLAUSE", "SETS_REQUIREMENT", "SETS_REQUIREMENT", "SETS_REQUIREMENT", "SETS_REQUIREMENT", "SETS_DEADLINE", "SETS_DEADLINE", "SETS_DEADLINE", "DEFINES_HANDLING", "DEFINES_HANDLING", "DEFINES_HANDLING", "DEFINES_HANDLING", "DEFINES_HANDLING"], "nodes": [{"id": "regulation:제10조:0", "label": "TermsDocument", "properties": {"version": "1.2", "effective_date": "2027-01-15", "supersedes": "1.1"}}, {"id": "regulation:제10조:1", "label": "Clause", "properties": {"clause_no": "제10조", "title": "연회비 면제 및 계약 해지에 따른 반환"}}, {"id": "regulation:제10조:2", "label": "Requirement", "properties": {"description": "본인회원의 직전 12개월 이용금액이 3,000,000원 이상이고 다음 연회비 청구일까지 연체가 없으면"}}, {"id": "regulation:제10조:3", "label": "Requirement", "properties": {"description": "면제 실적에서는 승인 취소·환불 금액, 세금·공과금, 상품권 구매, 선불 충전, 단기카드대출과 장기카드대출 이용금액을 제외합니다. 선택 서비스 비용은 면제 대상에 포함하지 않습니다."}}, {"id": "regulation:제10조:4", "label": "Deadline", "properties": {"description": "다음 연회비 청구 전에"}}, {"id": "regulation:제10조:5", "label": "Handling", "properties": {"situation": "면제 조건은 별도 신청 없이 다음 연회비 청구 전에 확인하며", "action": "카드사는 적용 여부와 산정 기간을 회원에게 안내합니다."}}, {"id": "regulation:제10조:6", "label": "Requirement", "properties": {"description": "신규회원의 첫해 연회비와 가족카드 연회비는 상품안내서에 따릅니다."}}, {"id": "regulation:제10조:7", "label": "Handling", "properties": {"situation": "유효기간 전에 계약을 해지하면", "action": "해지 다음 날부터 연회비 기간 종료일까지 남은 일수에 비례하여 반환 기준액을 계산합니다."}}, {"id": "regulation:제10조:8", "label": "Requirement", "properties": {"description": "신규 발급에 든 제작·배송비 4,000원과 이미 사용한 선택 서비스의 가상 원가는 반환 기준액에서 뺄 수 있습니다."}}, {"id": "regulation:제10조:9", "label": "Handling", "properties": {"situation": "선택 서비스 사용 여부는 제17조의 기록을 기준으로 확인합니다.", "action": ""}}, {"id": "regulation:제10조:10", "label": "Deadline", "properties": {"description": "7영업일 이내에"}}, {"id": "regulation:제10조:11", "label": "Handling", "properties": {"situation": "이용내역 조사로 계산이 늦어지면", "action": "지연 사유와 예정일을 알리고 해지일부터 60일 안에 처리합니다."}}, {"id": "regulation:제10조:12", "label": "Deadline", "properties": {"description": "해지일부터 60일 안에"}}, {"id": "regulation:제10조:13", "label": "Handling", "properties": {"situation": "", "action": "카드사는 반환액, 계산 기간, 공제 항목과 산식을 회원이 확인할 수 있도록 함께 제공합니다."}}], "rels": [{"type": "HAS_CLAUSE", "start": "regulation:제10조:0", "end": "regulation:제10조:1", "properties": {}}, {"type": "SETS_REQUIREMENT", "start": "regulation:제10조:1", "end": "regulation:제10조:2", "properties": {}}, {"type": "SETS_REQUIREMENT", "start": "regulation:제10조:1", "end": "regulation:제10조:3", "properties": {}}, {"type": "SETS_REQUIREMENT", "start": "regulation:제10조:1", "end": "regulation:제10조:6", "properties": {}}, {"type": "SETS_REQUIREMENT", "start": "regulation:제10조:1", "end": "regulation:제10조:8", "properties": {}}, {"type": "SETS_DEADLINE", "start": "regulation:제10조:1", "end": "regulation:제10조:4", "properties": {}}, {"type": "SETS_DEADLINE", "start": "regulation:제10조:1", "end": "regulation:제10조:10", "properties": {}}, {"type": "SETS_DEADLINE", "start": "regulation:제10조:1", "end": "regulation:제10조:12", "properties": {}}, {"type": "DEFINES_HANDLING", "start": "regulation:제10조:1", "end": "regulation:제10조:5", "properties": {}}, {"type": "DEFINES_HANDLING", "start": "regulation:제10조:1", "end": "regulation:제10조:7", "properties": {}}, {"type": "DEFINES_HANDLING", "start": "regulation:제10조:1", "end": "regulation:제10조:9", "properties": {}}, {"type": "DEFINES_HANDLING", "start": "regulation:제10조:1", "end": "regulation:제10조:11", "properties": {}}, {"type": "DEFINES_HANDLING", "start": "regulation:제10조:1", "end": "regulation:제10조:13", "properties": {}}], "seconds": 7.7}
