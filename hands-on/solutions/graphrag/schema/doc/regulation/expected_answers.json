      },
      "R2": {
        "answer": "없음",
        "location": "없음",
        "source": "LLM 초안"
      },
      "R3": {
        "answer": "적용 예정일과 사유 범주를 미리 알리며",
        "location": "제12조의2(이용정지와 한도 감액)",
        "source": "LLM 초안"
      },
      "R4": {
        "answer": "연체, 신용상태의 중대한 변화, 이상거래 또는 법령상 제한 사유가 확인되면 이용 범위나 한도를 조정할 수 있습니다. / 사유가 해소되면 본인 확인과 위험 재평가를 거쳐 이용정지 해제 또는 한도 회복 여부를 결정하고 결과를 통지합니다.",
        "location": "제12조의2(이용정지와 한도 감액)",
        "source": "LLM 초안"
      },
      "R5": {
        "answer": "version: 1.2 | effective_date: 2027-01-15 | supersedes: 1.1",
        "location": "source: D1_개인회원표준약관_합성.pdf",
        "source": "LLM 초안"
      }
    },
    "regulation:제12조의3": {
      "R1": {
        "answer": "제12조의3(휴면카드의 관리)",
        "location": "제12조의3(휴면카드의 관리)",
        "source": "LLM 초안"
      },
      "R2": {
        "answer": "연속된 장기 미사용 상태가 확인되면 / 이용정지 뒤 다음 연회비 청구일까지 회원의 의사 표시가 없으면",
        "location": "제12조의3(휴면카드의 관리)",
        "source": "LLM 초안"
      },
      "R3": {
        "answer": "회원에게 유지, 해지 또는 재사용 선택 방법을 안내합니다. / 다음 연회비 청구일까지",
        "location": "제12조의3(휴면카드의 관리)",
        "source": "LLM 초안"
      },
      "R4": {
        "answer": "연속된 장기 미사용 상태가 확인되면 신규 승인 기능을 정지하고 회원에게 유지, 해지 또는 재사용 선택 방법을 안내합니다. / 이용정지 뒤 다음 연회비 청구일까지 회원의 의사 표시가 없으면 계약 종료 절차를 진행하며, 이미 납부한 연회비는 제10조의 반환 기준을 적용합니다.",
        "location": "제12조의3(휴면카드의 관리)",
        "source": "LLM 초안"
      },
      "R5": {
        "answer": "version: 1.2 | effective_date: 2027-01-15 | supersedes: 1.1",
        "location": "header",
        "source": "LLM 초안"
      }
    },
