{
  "node_types": [
    {
      "label": "Article",
      "description": "\uac1c\uc778\ud68c\uc6d0 \uc774\uc6a9\uc57d\uad00\uc758 \uc870(\uc81cN\uc870) \ud558\ub098. \ud574\ub2f9: \uba38\ub9ac\uc904\uc758 article_no \ud558\ub098\uc5d0 \uc870\ud56d \ub178\ub4dc \ud558\ub098. \uc870\ud56d \ub178\ub4dc\uc5d0\ub294 article_no\uc640 title \ub9d0\uace0\ub3c4 condition\uacfc action\uc744 \uc6d0\ubb38 \ubb38\uc7a5 \uadf8\ub300\ub85c \ubc18\ub4dc\uc2dc \ucc44\uc6c0(\uc774 \uc870\uc758 \ub0b4\uc6a9\uc774 \uadf8\ub798\ud504\uc5d0 \ub0a8\ub294 \uacf3\uc784). \ubcf8\ubb38\uc774 \uac00\ub9ac\ud0a4\ub294 \ub2e4\ub978 \uc870(\uc608: \u300c\uc81c10\uc870\uc5d0 \ub530\ub985\ub2c8\ub2e4\u300d)\ub3c4 article_no\ub9cc \ucc44\uc6b4 \uc870\ud56d \ub178\ub4dc\ub85c \ub9cc\ub4e6. \ube44\ud574\ub2f9: \ud45c\uc9c0, \ubb38\uc11c \uc815\ubcf4, \ucc28\ub840, \uac01\uc8fc, \uc870 \uc548\uc758 \ud56d(\u2460, \u2461)\uc744 \ub530\ub85c \ub098\ub208 \uac83.",
      "properties": [
        {
          "name": "article_no",
          "type": "STRING",
          "description": "\uc870 \ubc88\ud638. \uba38\ub9ac\uc904\uc758 article_no \uac12\uc744 \uadf8\ub300\ub85c \uc500. \uc608: \uc81c10\uc870, \uc81c16\uc870\uc7582",
          "required": false
        },
        {
          "name": "title",
          "type": "STRING",
          "description": "\uc870 \uc81c\ubaa9. \uba38\ub9ac\uc904\uc758 title \uac12. \uc608: \uc5f0\ud68c\ube44 \uba74\uc81c \ubc0f \uacc4\uc57d \ud574\uc9c0\uc5d0 \ub530\ub978 \ubc18\ud658",
          "required": false
        },
        {
          "name": "condition",
          "type": "STRING",
          "description": "\ubc18\ub4dc\uc2dc \ucc44\uc6c0. \uc774 \uc870\uac00 \uc801\uc6a9\ub418\ub294 \uacbd\uc6b0\ub098 \uc870\uac74\uc744 \uc6d0\ubb38 \ubb38\uc7a5 \uadf8\ub300\ub85c \uc62e\uae40. \uc608: \ubcf8\uc778\ud68c\uc6d0\uc758 \uc9c1\uc804 12\uac1c\uc6d4 \uc774\uc6a9\uae08\uc561\uc774 3,000,000\uc6d0 \uc774\uc0c1\uc774\uace0 \ub2e4\uc74c \uc5f0\ud68c\ube44 \uccad\uad6c\uc77c\uae4c\uc9c0 \uc5f0\uccb4\uac00 \uc5c6\uc73c\uba74. \uc870\uac74 \uc5c6\uc774 \ub298 \uc801\uc6a9\ub418\ub294 \uc870\uc774\uba74 \uadf8 \uc870\uac00 \ub2e4\ub8e8\ub294 \ub300\uc0c1\uc744 \uc4f4 \uccab \ubb38\uc7a5\uc744 \uc62e\uae40",
          "required": false
        },
        {
          "name": "action",
          "type": "STRING",
          "description": "\ubc18\ub4dc\uc2dc \ucc44\uc6c0. \uce74\ub4dc\uc0ac\ub098 \ud68c\uc6d0\uc774 \ud558\ub294 \uc77c\uacfc \uc808\ucc28\ub97c \uc6d0\ubb38 \ubb38\uc7a5 \uadf8\ub300\ub85c 1 ~ 3\ubb38\uc7a5 \uc62e\uae40. \uc608: \ub2e4\uc74c \uc5f0\ub3c4\uc758 \uae30\ubcf8 \uc5f0\ud68c\ube44\ub97c \uc804\uc561 \uba74\uc81c\ud569\ub2c8\ub2e4. \uacb0\uacfc\ub97c \uc54c\ub9ac\ub294 \ubc29\ubc95\ub3c4 \uc5ec\uae30\uc5d0 \uc500",
          "required": false
        },
        {
          "name": "deadline",
          "type": "STRING",
          "description": "\uc6d0\ubb38\uc5d0 \uae30\ud55c\uc774\ub098 \uc54c\ub9bc \uc2dc\uc810(\uc77c, \uc601\uc5c5\uc77c, \uac1c\uc6d4, \uc804, \uc774\ub0b4)\uc774 \uc788\uc73c\uba74 \ubc18\ub4dc\uc2dc \uadf8\ub300\ub85c \uc62e\uae40. \uc608: \uba85\uc138\uc11c\uac00 \uac8c\uc2dc\ub41c \ub0a0\ubd80\ud130 45\uc77c \uc774\ub0b4. \uc5c6\uc73c\uba74 \ube44\uc6c0",
          "required": false
        },
        {
          "name": "amount",
          "type": "STRING",
          "description": "\uc6d0\ubb38\uc5d0 \uae30\uc900 \uae08\uc561, \ube44\uc728, \ud69f\uc218\uac00 \uc788\uc73c\uba74 \ubc18\ub4dc\uc2dc \uadf8\ub300\ub85c \uc62e\uae40. \uc608: 3,000,000\uc6d0 \uc774\uc0c1. \uc5c6\uc73c\uba74 \ube44\uc6c0",
          "required": false
        }
      ],
      "additional_properties": false
    },
    {
      "label": "Topic",
      "description": "\ub2e8\uc704\uac00 \ub2e4\ub8e8\ub294 \uc5c5\ubb34 \ub300\uc0c1 \ud558\ub098\ub97c \uc9e7\uc740 \uba85\uc0ac\ub85c \uc4f4 \uac83(\uc608: \uc5f0\ud68c\ube44, \ubcf8\uc778 \ud655\uc778, \uad11\uace0 \uc218\uc2e0). \ud574\ub2f9: \uadf8 \ub2e8\uc704\uac00 \ub2e4\ub8e8\ub294 \uc5c5\ubb34 \ub300\uc0c1\uc744 2 ~ 8\uae00\uc790\uc758 \uba85\uc0ac\ub85c \uc500(\uc608: \uc5f0\ud68c\ube44, \ubcf8\uc778 \ud655\uc778, \uad11\uace0 \uc218\uc2e0, \ud61c\ud0dd \uc2e0\uccad, \uc774\uc758\uc2e0\uccad, \uacb0\uc81c\uc77c, \ud574\uc678 \uacb0\uc81c, \uce74\ub4dc \ud574\uc9c0). \ud61c\ud0dd \ud56d\ubaa9\uc774\uba74 \uadf8 \ud61c\ud0dd\uc774 \uc4f0\uc774\ub294 \uacf3\uc774\ub098 \ub300\uc0c1\uc744 \uc500(\uc608: \uc678\uc2dd, \ub300\uc911\uad50\ud1b5, \ub514\uc9c0\ud138 \uad6c\ub3c5, \ud574\uc678 \uacb0\uc81c, \uc804\uae30\ucc28 \ucda9\uc804, \ud1b5\ud569 \ud55c\ub3c4). \ub2e8\uc704 \ud558\ub098\uc5d0 \uac00\uc7a5 \uc911\uc2ec \ub300\uc0c1\ubd80\ud130 1 ~ 3\uac1c, \ub9ce\uc544\uc57c 3\uac1c. \ube44\ud574\ub2f9: \ubd88\ud3b8, \ubd88\ub9cc, \ubb38\uc758, \uc548\ub0b4, \uacc4\uc0b0 \uac19\uc740 \ub9d0, \ud61c\ud0dd, \ud560\uc778, \uc801\ub9bd, \uce90\uc2dc\ubc31, \ubcf4\ub108\uc2a4\ucc98\ub7fc \ub108\ubb34 \ub113\uc740 \ub9d0, \uce74\ub4dc \uc774\ub984, \uac00\ub9f9\uc810 \uc774\ub984, \uae08\uc561, \ub0a0\uc9dc, \uc0ac\ub78c.",
      "properties": [
        {
          "name": "name",
          "type": "STRING",
          "description": "\uc8fc\uc81c\uc758 \ub300\ud45c \uc774\ub984. \ub744\uc5b4\uc4f0\uae30\ub294 \ub0b1\ub9d0 \uc0ac\uc774\uc5d0 \ud55c \uce78. \uc608: \uc5f0\ud68c\ube44, \ubcf8\uc778 \ud655\uc778",
          "required": false
        }
      ],
      "additional_properties": false
    }
  ],
  "relationship_types": [
    {
      "label": "REFERS_TO",
      "description": "\uc870\ud56d\uc774 \ubcf8\ubb38\uc5d0\uc11c \ub530\ub974\ub77c\uace0 \uac00\ub9ac\ud0a4\ub294 \ub2e4\ub978 \uc870\ud56d. \ud574\ub2f9: \u300c\uc81cN\uc870\uc5d0 \ub530\ub985\ub2c8\ub2e4\u300d, \u300c\uc81cN\uc870\uc758 \uae30\uc900\uc744 \uc801\uc6a9\ud569\ub2c8\ub2e4\u300d. \ube44\ud574\ub2f9: \uc790\uae30 \uc790\uc2e0.",
      "properties": [],
      "additional_properties": true
    },
    {
      "label": "ABOUT",
      "description": "\ub2e8\uc704\uac00 \ub2e4\ub8e8\ub294 \uc8fc\uc81c. \uc870\ud56d, \ud61c\ud0dd, \ubd88\ub9cc\ub9c8\ub2e4 \uc8fc\uc81c\ub97c 1 ~ 3\uac1c \ubc18\ub4dc\uc2dc \uc787\ub294\ub2e4(\uc8fc\uc81c \uc5c6\ub294 \uc870\ud56d, \ud61c\ud0dd, \ubd88\ub9cc\uc744 \ub9cc\ub4e4\uc9c0 \uc54a\uc74c). \ud574\ub2f9: \uadf8 \ub2e8\uc704\uc758 \uc911\uc2ec \ub300\uc0c1. \ube44\ud574\ub2f9: \uc9c0\ub098\uac00\ub4ef \ud55c \ubc88 \ub098\uc628 \ub0b1\ub9d0.",
      "properties": [],
      "additional_properties": true
    }
  ],
