        {
          "name": "reason",
          "type": "STRING",
          "description": "\uace0\uac1d\uc774 \uc218\uc6a9, \uac70\uc808, \ubcf4\ub958\ud558\uba70 \ub9d0\ud55c \uc774\uc720 \ubb38\uc7a5(\uc6d0\ubb38 \uadf8\ub300\ub85c)",
