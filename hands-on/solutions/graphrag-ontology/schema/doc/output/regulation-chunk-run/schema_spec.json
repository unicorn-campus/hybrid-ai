  "node_types": [
    {
      "label": "TermsDocument",
      "ko": "약관 문서",
      "description": "해당: 약관 파일 한 판(머리줄의 source와 version). 비해당: 조항 하나, 상품안내서",
      "properties": [
        {
          "name": "version",
          "description": "약관 판. 머리줄 version 값(예: 1.2)",
          "required": true
        },
        {
          "name": "effective_date",
          "description": "시행일. 머리줄 effective_date 값"
        },
        {
          "name": "supersedes",
          "description": "바뀌기 전 판. 머리줄 supersedes 값"
        }
      ]
    },
    {
      "label": "Clause",
      "ko": "조항",
      "description": "해당: 본문에 조문 내용(①, ② 같은 항)이 함께 적힌 '제N조(제목)' 하나. 비해당: 차례(목차)에 제목만 나열된 조항, 조항 안의 항이나 호, 약관 문서 전체",
      "properties": [
        {
          "name": "clause_no",
          "description": "조항 번호(예: 제16조의2)",
          "required": true
        },
        {
          "name": "title",
          "description": "조항 제목(괄호 안 글자)",
          "required": true
        }
      ]
    },
    {
      "label": "Requirement",
      "ko": "충족 조건",
      "description": "해당: 어떤 처리나 면제를 받기 위해 충족해야 하는 금액, 기간, 횟수 조건. 비해당: 기한, 통지 시점, 상황이 생겼을 때의 처리",
      "properties": [
        {
          "name": "description",
          "description": "조건 문장(원문 그대로)",
          "required": true
        }
      ]
    },
    {
      "label": "Deadline",
      "ko": "기한과 통지 시점",
      "description": "해당: 상황 조건 없이 회원이나 카드사가 무엇을 해야 하는 기한이나 미리 알려야 하는 시점(예: ~일 이내 요청, ~일 전 안내). 비해당: '~이면'으로 시작하는 상황별 처리(Handling에 씀), 금액 조건",
      "properties": [
        {
          "name": "description",
          "description": "기한이나 통지 시점 문장(원문 그대로)",
          "required": true
        }
      ]
    },
    {
      "label": "Handling",
      "ko": "상황별 처리",
      "description": "해당: '~이면, ~하면, ~경우'처럼 상황을 먼저 말하고 그때의 처리를 정한 문장(예: 결제일이 휴일이면 다음 영업일에 출금, 오래 쓰지 않은 카드는 이용을 정지). 처리 시점이 함께 적혀 있어도 상황이 앞에 있으면 여기에 씀. 비해당: 상황 없이 기한만 정한 문장, 처리를 받기 위한 금액 조건",
      "properties": [
        {
          "name": "situation",
          "description": "상황(원문 그대로)",
          "required": true
        },
        {
          "name": "action",
          "description": "그때의 처리(원문 그대로)"
        }
      ]
    }
  ],
