@prefix card: <https://hanbit-card.example/ontology#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# 문서 Shape: 약관(regulation). Step 6.4
# 허용 클래스는 약관 조항(card:Clause) 하나뿐이고 관계 패턴은 없음(되돌아가기 2번에서 전용 클래스 4개와 관계 2개를 뺌).
# 약관 질문은 조항을 찾은 뒤 조항 본문에서 답함(지식 경로 '문서 검색').
# 조항 번호와 제목은 모두 분할 규칙이 경계로 쓴 줄에서 읽으므로 약관은 LLM 추출을 하지 않음(card:doc_regulation).
# 약관 문장 속 '회원', '카드'는 특정 대상을 가리키지 않으므로 노드로 뽑지 않음(card.ttl 의 card:Member, card:Card 비해당 범위).
# 메타데이터: units.json 의 item_key(조항 번호). 본문에 없는 값은 없음.

card:regulation_ClauseShape a sh:NodeShape ;
    sh:targetClass card:Clause ;
    sh:closed true ; sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:path card:clauseNo ; sh:datatype xsd:string ; sh:order 0 ; card:keyOrder 0 ;
            card:fill "메타데이터" ; card:fillNote "units.json 의 item_key(조항 단위 분할 규칙이 조항 제목 줄에서 읽은 번호)" ] ,
        [ sh:path card:clauseTitle ; sh:datatype xsd:string ; sh:order 1 ;
            card:fill "메타데이터" ; card:fillNote "추출 청크 본문에서 분할 규칙(doc/regulation/unit_text_rules.json 의 marker_regex)의 조항 제목 식(title 묶음)으로 읽음. units.json 은 고치지 않음" ] .

card:doc_regulation a card:DocumentKind ;
    card:docId "regulation" ;
    card:llmExtraction false ;
    rdfs:comment "약관 Shape 의 모든 속성이 분할 규칙과 메타데이터로 채워지므로 LLM 추출을 하지 않고 채우는 단계만 돌림(메모 201번 수용)"@ko .
