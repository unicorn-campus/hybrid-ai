{
  "name": "sqlkiwi-openai",
  "version": "0.1.0",
  "description": "sqlkiwi — a local-first desktop SQL workbench inspired by DBeaver workflows",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "electron:install": "install-electron --no",
    "predev": "npm run electron:install",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "prestart": "npm run electron:install",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "node test/e2e.mjs",
    "prepackage:win": "npm run electron:install",
    "package:win": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "pg-cursor": "^2.22.1"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.0.0",
    "@codemirror/commands": "^6.0.0",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/pg-cursor": "^2.7.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-vite": "^6.0.0",
    "lucide-react": "^0.577.0",
    "playwright-core": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "@lezer/highlight": "^1.2.3"
  }
}
